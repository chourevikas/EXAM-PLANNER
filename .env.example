# Application Configuration
APP_NAME="Exam Mentorship Platform"
ENVIRONMENT="development"
LOG_LEVEL="INFO"

# Database Connection (Async SQLite for local dev, PostgreSQL for prod)
DATABASE_URL="sqlite+aiosqlite:///exam_platform.db"

# Storage Settings ('local' or 's3')
STORAGE_TYPE="local"
LOCAL_STORAGE_PATH="./storage_data"

# AWS S3 Settings (Required only if STORAGE_TYPE='s3')
# S3_BUCKET_NAME="my-exam-bucket"
# AWS_REGION="us-east-1"
# AWS_ACCESS_KEY_ID="your_access_key"
# AWS_SECRET_ACCESS_KEY="your_secret_key"

# LLM Provider & Credentials (vertexai, openai, bedrock)
LLM_PROVIDER="vertexai"
GCP_PROJECT_ID="your-gcp-project-id"
GCP_LOCATION="us-central1"
GEMINI_MODEL_NAME="gemini-1.5-flash"
GOOGLE_APPLICATION_CREDENTIALS="gcp-service-account.json"
VISION_LLM_RATE_LIMIT_RPS=0.5

# OpenAI Settings (Optional fallback)
# OPENAI_API_KEY="sk-proj-your-openai-api-key-here"
# OPENAI_MODEL_NAME="gpt-4.1"

# Celery & Broker Settings (Redis / RabbitMQ)
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/0"

# Caching Layer Settings
CACHE_ENABLED=true
CACHE_TYPE="memory" # 'redis', 'memory', 'none', or 'auto'
CACHE_IN_MEMORY_MAX_SIZE=1000
CACHE_DEFAULT_TTL_SECONDS=300
REDIS_CACHE_URL="redis://localhost:6379/1"
CACHE_KEY_PREFIX="ep"

# Output Artifact Directory
OUTPUT_ARTIFACTS_DIR="./output_artifacts"

# ── Security / Super Admin app ─────────────────────────────────────────────
# REQUIRED in production: a long random value. The API refuses to start in production with the default.
# SECRET_KEY=
# SUPERADMIN_EMAIL=
# SUPERADMIN_PASSWORD=
# Comma-separated extra origins for CORS (FRONTEND_URL is always allowed). Production is same-origin, so usually empty.
# CORS_ALLOWED_ORIGINS=
# Set true when the site is served over HTTPS so the refresh cookie gets the Secure flag.
# COOKIE_SECURE=true
# Super Admins: short-lived access tokens (they refresh silently) and mandatory authenticator app (TOTP).
# SUPERADMIN_ACCESS_TOKEN_EXPIRE_MINUTES=30
# SUPERADMIN_MFA_REQUIRED=true
# Only allow Super Admin sign-in / API use through the Super Admin app (identified by the X-Client-App header its
# nginx sets). Turn on ONLY after that app is live, and keep the API port (8000) private so the header can't be forged.
# SUPERADMIN_APP_ENFORCED=false
# Sign-in lockout per email address.
# LOGIN_MAX_FAILED_ATTEMPTS=5
# LOGIN_LOCKOUT_MINUTES=15