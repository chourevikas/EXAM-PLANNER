---
import BaseLayout from '../layouts/BaseLayout.astro';
import { api, type Plan } from '../lib/api';
import { SITE, absoluteUrl } from '../lib/site';

// Plans live in the database; render per request (cached in lib/api) so price edits show up without a redeploy.
export const prerender = false;

let plans: Plan[] = [];
try {
  plans = await api.plans();
} catch (err) {
  console.error('pricing: could not load plans', err);
}
Astro.response.headers.set('Cache-Control', 'public, max-age=300');

const FEATURES = [
  'Unlimited Access to 25+ Years UPSC CSE PYQs',
  'Full-Length & Sectional Smart Mock Test Series',
  'Deep Psychometric Option Hesitation & Mistake Tracking',
  'Dynamic Adaptive Daily Study Planner',
  'All India Rank Projection & Percentile Matrix',
  'Priority 24/7 Doubt Resolution & Detailed Explanations',
  'Export Performance Reports & Revision Worksheets',
];

const INTERVAL_LABEL: Record<string, string> = { MONTHLY: 'month', QUARTERLY: 'quarter', ANNUAL: 'year', YEARLY: 'year' };
const intervalLabel = (p: Plan) => INTERVAL_LABEL[p.billing_interval.toUpperCase()] ?? p.billing_interval.toLowerCase();
const price = (p: Plan) =>
  new Intl.NumberFormat('en-IN', { style: 'currency', currency: p.currency || 'INR', maximumFractionDigits: 0 }).format(p.price_cents / 100);
// Plans can list their own features in metadata_json.features; otherwise paid plans show the Pro list
// and free plans rely on their description (never advertise Pro features on a free tier).
const featuresFor = (p: Plan) => {
  const own = p.metadata_json?.features;
  if (Array.isArray(own) && own.length) return own;
  return p.price_cents > 0 ? FEATURES : [];
};

const productLd = plans.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'Product',
      name: `${SITE.name} Pro`,
      description: 'PYQ-first exam preparation with mock tests, analytics and an adaptive study planner.',
      brand: { '@type': 'Brand', name: SITE.name },
      image: absoluteUrl('/icon-512.png'),
      offers: plans.map((p) => ({
        '@type': 'Offer',
        name: p.name,
        price: (p.price_cents / 100).toFixed(2),
        priceCurrency: p.currency || 'INR',
        availability: 'https://schema.org/InStock',
        url: absoluteUrl('/pricing'),
      })),
    }
  : undefined;
---

<BaseLayout
  title="Pricing – ExamPlanner Pro Plans for UPSC Preparation"
  description="Compare ExamPlanner plans: unlimited UPSC PYQs, smart mock tests, mistake tracking and an adaptive study planner. Start free and upgrade when you're ready."
  jsonLd={productLd}
>
  <section class="landing-section-padding mk-page-hero" style="text-align:center">
    <div class="landing-container" style="max-width:760px">
      <div class="section-label" style="justify-content:center">Pricing</div>
      <h1 class="section-heading" style="font-weight:800;color:var(--text-main);margin-bottom:12px">Unlock Your Full Potential with ExamPlanner Pro</h1>
      <p class="section-subheading" style="color:var(--text-muted);margin:0 auto">
        Start free with PYQ practice. Upgrade for unlimited mock tests, behavioural tracking and personalised study schedules.
      </p>
    </div>
  </section>

  <section class="landing-section-padding" style="background:var(--bg-body);padding-top:0">
    <div class="landing-container" style="max-width:1080px">
      {plans.length === 0 ? (
        <div class="mk-card" style="padding:32px;text-align:center;color:var(--text-muted)">
          Plans are loading slowly right now. <a href="/signup" style="color:var(--primary-red)">Create a free account</a> to see the latest pricing inside the app.
        </div>
      ) : (
        <div class="mk-plans">
          {plans.map((p) => (
            <article class="mk-card mk-plan">
              <h2 class="mk-plan-name">{p.name}</h2>
              {p.description && <p class="mk-plan-desc">{p.description}</p>}
              <p class="mk-plan-price">
                {p.price_cents === 0 ? 'Free' : price(p)}
                {p.price_cents > 0 && <span> / {intervalLabel(p)}</span>}
              </p>
              <ul>
                {featuresFor(p).map((f) => <li>{f}</li>)}
              </ul>
              <a href={p.price_cents === 0 ? '/signup' : `/billing?plan=${encodeURIComponent(p.plan_code)}`} class="btn btn-primary anim-glow touch-target" style="width:100%;padding:14px">
                {p.price_cents === 0 ? 'Start Free' : `Get ${p.name}`}
              </a>
            </article>
          ))}
        </div>
      )}
      <p style="text-align:center;font-size:13px;color:var(--text-muted);margin-top:24px">
        Secure payments via UPI, cards and net banking. See our <a href="/refund-policy" style="color:inherit">refund policy</a>.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .mk-plans { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px; }
  .mk-plan { padding: 28px; display: flex; flex-direction: column; gap: 12px; }
  .mk-plan-name { font-size: 20px; font-weight: 800; color: var(--text-main); margin: 0; }
  .mk-plan-desc { font-size: 14px; color: var(--text-muted); margin: 0; line-height: 1.6; }
  .mk-plan-price { font-size: 36px; font-weight: 800; color: var(--text-main); margin: 4px 0; letter-spacing: -0.02em; }
  .mk-plan-price span { font-size: 16px; font-weight: 500; color: var(--text-muted); }
  .mk-plan ul { list-style: none; padding: 0; margin: 0 0 8px; display: flex; flex-direction: column; gap: 10px; flex: 1; }
  .mk-plan li { font-size: 14px; color: var(--text-main); padding-left: 24px; position: relative; line-height: 1.5; }
  .mk-plan li::before { content: '✓'; position: absolute; left: 0; color: var(--success-primary, #3a8b53); font-weight: 800; }
</style>
