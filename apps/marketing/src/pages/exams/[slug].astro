---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { breadcrumbLd } from '../../lib/jsonld';
import { SITE, absoluteUrl } from '../../lib/site';

export async function getStaticPaths() {
  const exams = await getCollection('exams');
  return exams.map((entry) => ({ params: { slug: entry.id }, props: { entry, all: exams } }));
}

const { entry, all } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const path = `/exams/${entry.id}`;
const practiceHref = `/guest-exam?exam=${encodeURIComponent(d.practiceExam)}&locked=true`;
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Exams', path: '/exams' },
  { name: d.shortName, path },
];
const others = all.filter((e) => e.id !== entry.id).sort((a, b) => a.data.order - b.data.order);

const jsonLd = [
  breadcrumbLd(crumbs),
  {
    '@context': 'https://schema.org',
    '@type': 'Course',
    name: `${d.shortName} preparation with PYQs`,
    description: d.description,
    url: absoluteUrl(path),
    provider: { '@type': 'Organization', name: SITE.name, sameAs: SITE.url },
    inLanguage: 'en-IN',
    isAccessibleForFree: true,
    hasCourseInstance: { '@type': 'CourseInstance', courseMode: 'online', courseWorkload: 'PT2H' },
    offers: { '@type': 'Offer', category: 'Free', price: '0', priceCurrency: 'INR' },
  },
  ...(d.faqs.length
    ? [{
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: d.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
      }]
    : []),
];
---

<BaseLayout title={d.title} description={d.description} jsonLd={jsonLd} type="article">
  <section class="landing-section-padding mk-page-hero">
    <div class="landing-container mk-narrow">
      <Breadcrumbs items={crumbs} />
      <div class="section-label">{d.icon} {d.shortName}</div>
      <h1 class="section-heading" style="font-weight:800;color:var(--text-main);margin-bottom:12px">{d.name}: Pattern, Syllabus & PYQ Practice</h1>
      <p style="font-size:13px;color:var(--text-muted);margin:0 0 24px">
        Updated <time datetime={d.updated.toISOString().slice(0, 10)}>{d.updated.toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' })}</time>
      </p>
      <div style="display:flex;flex-wrap:wrap;gap:12px;margin-bottom:40px">
        <a href={practiceHref} class="btn btn-primary anim-glow touch-target" style="padding:14px 28px">Practise {d.shortName} PYQs free</a>
        <a href="/signup" class="btn btn-ghost touch-target" style="padding:14px 28px">Create free account</a>
      </div>

      <article class="prose">
        <Content />
      </article>

      {d.faqs.length > 0 && (
        <section style="margin-top:56px">
          <h2 class="section-heading" style="font-weight:800;color:var(--text-main);font-size:clamp(1.4rem,2vw+0.6rem,1.9rem);margin-bottom:20px">{d.shortName} FAQs</h2>
          <div class="mk-faq">
            {d.faqs.map((f) => (
              <details>
                <summary>{f.q}</summary>
                <p>{f.a}</p>
              </details>
            ))}
          </div>
        </section>
      )}

      <section class="mk-card" style="margin-top:56px;padding:32px;text-align:center">
        <h2 style="font-size:22px;font-weight:800;color:var(--text-main);margin:0 0 8px">Start your {d.shortName} preparation PYQ-first</h2>
        <p style="color:var(--text-muted);margin:0 0 20px">Take a free practice test now – no sign-up needed.</p>
        <a href={practiceHref} class="btn btn-primary anim-glow touch-target" style="padding:14px 28px">Start free practice test</a>
      </section>

      {others.length > 0 && (
        <nav aria-label="Other exams" style="margin-top:40px">
          <h2 style="font-size:16px;font-weight:700;color:var(--text-main);margin:0 0 12px">Other exams</h2>
          <ul style="margin:0;padding-left:20px">
            {others.map((o) => <li><a href={`/exams/${o.id}`} style="color:var(--primary-red)">{o.data.name}</a></li>)}
          </ul>
        </nav>
      )}
    </div>
  </section>
</BaseLayout>
