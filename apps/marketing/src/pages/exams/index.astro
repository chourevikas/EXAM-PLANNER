---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { breadcrumbLd } from '../../lib/jsonld';
import { absoluteUrl } from '../../lib/site';

const exams = (await getCollection('exams')).sort((a, b) => a.data.order - b.data.order);
const crumbs = [{ name: 'Home', path: '/' }, { name: 'Exams', path: '/exams' }];
const listLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: exams.map((e, i) => ({ '@type': 'ListItem', position: i + 1, url: absoluteUrl(`/exams/${e.id}`), name: e.data.name })),
};
---

<BaseLayout
  title="UPSC & State PSC Exams – Pattern, Syllabus, PYQs"
  description="Choose your exam – UPSC CSE, MPSC Rajyaseva and more. See the exam pattern, syllabus and eligibility, then practise previous year questions and mock tests free."
  jsonLd={[breadcrumbLd(crumbs), listLd]}
>
  <section class="landing-section-padding mk-page-hero">
    <div class="landing-container" style="max-width:1080px">
      <Breadcrumbs items={crumbs} />
      <div style="text-align:center">
        <div class="section-label" style="justify-content:center">Practice Exams</div>
        <h1 class="section-heading" style="font-weight:800;color:var(--text-main);margin-bottom:12px">Choose Your Exam Target</h1>
        <p class="section-subheading" style="color:var(--text-muted);max-width:560px;margin:0 auto 48px">
          Exam pattern, syllabus and eligibility for each exam, plus free practice with previous year questions and smart mock tests.
        </p>
      </div>
      <div class="mk-exam-grid">
        {exams.map((e) => (
          <a href={`/exams/${e.id}`} class="mk-card mk-exam-card">
            <span style="font-size:32px" aria-hidden="true">{e.data.icon}</span>
            <h2>{e.data.name}</h2>
            <p>{e.data.description}</p>
            <span class="mk-exam-cta">Pattern, syllabus & PYQs →</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .mk-exam-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 24px; }
  .mk-exam-card {
    padding: 24px; border-radius: 12px; display: flex; flex-direction: column; gap: 12px; text-decoration: none;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .mk-exam-card:hover { transform: translateY(-4px); border-color: var(--accent-primary); box-shadow: 0 12px 24px rgba(var(--primary-red-rgb), 0.08); }
  .mk-exam-card h2 { font-size: 18px; font-weight: 700; color: var(--text-main); margin: 0; }
  .mk-exam-card p { font-size: 13.5px; color: var(--text-muted); line-height: 1.55; margin: 0; flex: 1; }
  .mk-exam-cta { font-size: 14px; font-weight: 600; color: var(--accent-primary); }
</style>
